<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <style>
      /* Global Styles */
      body {
        background: linear-gradient(135deg, blue, goldenrod), linear-gradient(180deg, blue, red);
        color: antiquewhite;
        font-family: 'Poppins', sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
        background-size: cover;
        background-attachment: fixed;
      }

      h1 {
        font-size: 2.5rem;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }

      h2 {
        font-size: 2rem;
        margin-top: 30px;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }

      /* Navigation Bar */
      .navbar {
        position: absolute;
        top: 10px;
        right: 20px;
      }

      .navbar a {
        text-decoration: none;
        color: white;
        margin-left: 10px;
        padding: 8px 15px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        font-weight: bold;
        transition: background 0.3s ease;
      }

      .navbar a:hover {
        background: rgba(255, 255, 255, 0.3);
      }

      /* Form Styles */
      form {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        background: rgba(255, 255, 255, 0.1);
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 400px;
      }

      input[type="text"] {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.9);
        color: #333;
        outline: none;
        transition: background 0.3s ease;
      }

      input[type="text"]:focus {
        background: rgba(255, 255, 255, 1);
      }

      button {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        background: #4caf50;
        color: white;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
      }

      button:hover {
        background: #45a049;
        transform: scale(1.05);
      }

      /* List Styles */
      ul {
        list-style: none;
        padding: 0;
        width: 100%;
        max-width: 400px;
      }

      li {
        background: rgba(255, 255, 255, 0.1);
        margin: 10px 0;
        padding: 10px;
        border-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        transition: background 0.3s ease;
      }

      li:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      a {
        color: antiquewhite;
        text-decoration: none;
        font-weight: bold;
        transition: color 0.3s ease;
      }

      a:hover {
        color: #4caf50;
      }

      span {
        font-size: 0.9rem;
        color: #ccc;
      }

      /* Responsive Design */
      @media (max-width: 480px) {
        h1 {
          font-size: 2rem;
        }

        h2 {
          font-size: 1.5rem;
        }

        form {
          padding: 15px;
        }

        input[type="text"] {
          font-size: 0.9rem;
        }

        button {
          font-size: 0.9rem;
        }
      }
    </style>
    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navigation Bar -->
    <div class="navbar">
      <% if (user) { %>
        <a href="/auth/logout">Logout</a>
      <% } else { %>
        <a href="/auth/login">Login</a>
        <a href="/auth/register">Register</a>
      <% } %>
    </div>

    <h1>URL Shortener</h1>

    <% if (user) { %>
      <p>Welcome, <%= user.email %>!</p>

      <form action="/shorten" method="POST">
        <input type="text" name="fullUrl" placeholder="Enter your URL" required />
        <button type="submit">Shorten</button>
      </form>

      <h2>Shortened URLs</h2>
      <ul>
        <% urls.forEach(url => { %>
          <li>
            <a href="/<%= url.shortUrl %>" target="_blank">http://localhost:3000/<%= url.shortUrl %></a>
            - <span><%= url.clicks %> clicks</span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>Please <a href="/auth/login">login</a> to shorten URLs.</p>
    <% } %>
  </body>
</html>


